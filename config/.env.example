# Plexbie configuration.
#
#   cp config/.env.example config/.env
#
# Only the four variables under REQUIRED are needed to start. Everything else is
# optional: a plugin that needs a missing setting logs a warning and stands down
# rather than failing.
#
# Numeric settings that cannot be parsed are logged and ignored, not fatal:
#   Ignoring invalid integer for BOT_OWNER_ID: 'novaora' - this setting is now INACTIVE.
#
# Never commit config/.env - it is gitignored.


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

DISCORD_BOT_TOKEN=
# Needs the Server Members and Message Content privileged intents.

GUILD_ID=
# Your server's ID. Commands sync to this guild and appear immediately.
# Leave it blank to register globally instead (up to an hour to propagate).

PLEX_URL=http://localhost:32400
PLEX_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# ADMINISTRATION
# ─────────────────────────────────────────────────────────────────────────────
# Any one of these grants admin: the Discord `administrator` permission, the
# ADMIN_ROLE_ID role, or BOT_OWNER_ID.

BOT_OWNER_ID=
ADMIN_ROLE_ID=
ADMIN_CHANNEL_ID=
# Where access requests land and where health alerts are sent.

# Removing a Plex user goes through plex.tv, not the local server, so it needs
# real credentials. Invites and reads work without them; without them the bot
# keeps the tracking row and retries rather than dropping a user it could not
# remove.
PLEX_USERNAME=
PLEX_PASSWORD=


# ─────────────────────────────────────────────────────────────────────────────
# CHANNELS AND ROLES
# ─────────────────────────────────────────────────────────────────────────────

UPDATES_CHANNEL_ID=
# New media announcements.

WELCOME_CHANNEL_ID=
PLEX_MEMBER_ROLE_ID=
# Granted when a Plex invite is accepted.

DISCORD_REQUIRED_ROLE_ID=
# If set, only members with this role may request access.

WEBHOOK_NOTIFICATION_CHANNEL=


# ─────────────────────────────────────────────────────────────────────────────
# STATS DISPLAYS  (watch_tracking)
# ─────────────────────────────────────────────────────────────────────────────
# The three messages must already exist. Post a placeholder in the channel and
# put its ID here. The bot only edits them, never creates them, so a wrong ID
# cannot litter the channel.

STATS_CHANNEL_ID=
NOW_WATCHING_MESSAGE_ID=
LEADERBOARD_MESSAGE_ID=
WATCH_STREAK_MESSAGE_ID=


# ─────────────────────────────────────────────────────────────────────────────
# INTEGRATIONS
# ─────────────────────────────────────────────────────────────────────────────
# Tautulli drives the leaderboard and the inactivity check. TMDB enriches new
# media announcements with artwork and summaries.

TAUTULLI_URL=
TAUTULLI_TOKEN=

TMDB_API_KEY=

OVERSEERR_URL=
OVERSEERR_TOKEN=

# The *arr command plugins are stubs, but their webhook handling is real.
SONARR_URL=
SONARR_TOKEN=
RADARR_URL=
RADARR_TOKEN=
LIDARR_URL=
LIDARR_TOKEN=
BAZARR_URL=
BAZARR_TOKEN=
READARR_URL=
READARR_TOKEN=

NZBHYDRA_URL=
NZBHYDRA_API_KEY=
SABNZBD_URL=
SABNZBD_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# WEBHOOK LISTENER
# ─────────────────────────────────────────────────────────────────────────────

WEBHOOK_PORT=8080
WEBHOOK_BIND=127.0.0.1
# Loopback by default. Widening this exposes every /webhook/* route - and a route
# whose secret is unset accepts unauthenticated requests. Set the secrets first.
WEBHOOK_PATH=/webhook

# How each service presents its secret differs by what it can send:
#   Sonarr / Radarr  X-Api-Key header, equal to the secret
#   Tautulli         Authorization: Bearer <secret>, or ?token=<secret>
#   Plex             ?token=<secret> appended to the webhook URL (Plex sends no auth)
#   Overseerr        Authorization header
#   Bazarr           ?token=<secret>
SONARR_WEBHOOK_SECRET=
RADARR_WEBHOOK_SECRET=
TAUTULLI_WEBHOOK_SECRET=
OVERSEERR_WEBHOOK_SECRET=
PLEX_WEBHOOK_SECRET=
BAZARR_WEBHOOK_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# BEHAVIOUR
# ─────────────────────────────────────────────────────────────────────────────

INACTIVITY_WARNING_DAYS=25
INACTIVITY_REMOVAL_DAYS=30
# A warning is always delivered a full pass before any removal.

HEALTH_CHECK_INTERVAL=300
HEALTH_MAX_FAILURES=3
HEALTH_ALERT_COOLDOWN=1800

WATCH_PARTY_CHANNEL_ID=
WATCH_PARTY_CREDIT_INTERVAL=300


# ─────────────────────────────────────────────────────────────────────────────
# BOOKSHELF PROCESSOR
# ─────────────────────────────────────────────────────────────────────────────
# Container paths. Mount your download and library directories onto these.

BOOKSHELF_AUDIOBOOK_WATCH=/watch/audiobooks
BOOKSHELF_EBOOK_WATCH=/watch/ebooks
BOOKSHELF_AUDIOBOOK_LIBRARY=/library/audiobooks
BOOKSHELF_EBOOK_LIBRARY=/library/ebooks

BOOKSHELF_SETTLE_SECONDS=120
# How long an item must stop changing before it is treated as a finished download.

BOOKSHELF_CACHE_DIR=/app/cache/bookshelf
# Where downloaded cover art is cached.


# ─────────────────────────────────────────────────────────────────────────────
# STORAGE AND LOGGING
# ─────────────────────────────────────────────────────────────────────────────

DB_URL=sqlite:///config/plexbie.db
# Keep this off any file-syncing tool: syncing a live SQLite file can corrupt it.

REDIS_URL=
# Optional. Without it the bot uses an in-process cache with the same interface.

LOG_LEVEL=INFO
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=5


# ─────────────────────────────────────────────────────────────────────────────
# NOVELTY PLUGINS
# ─────────────────────────────────────────────────────────────────────────────
# self_roles, forever_dumb and invite_tracker. Leave blank to skip them.

HOMIES_ROLE_ID=
NERD_ROLE_ID=
DUMB_ROLE_ID=
NERDS_BUT_DUMB_ROLE_ID=
NERD_MESSAGE_ID=
NERD_CAT_EMOJI_ID=
DUMB_CAT_EMOJI_ID=
FOREVER_DUMB_ROLE_ID=
FOREVER_DUMB_MESSAGE_ID=
DUMB_FAMILY_MESSAGE_ID=
YOU_ARE_DUMB_CHANNEL_ID=
